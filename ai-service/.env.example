# Copy to .env and fill in real values before running the service.
# Get an OpenRouter key at https://openrouter.ai/keys

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: only needed when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here

CHAT_MODEL=dots-studio/dots-3-note-preview:free
EMBEDDING_MODEL=openai/text-embedding-3-small
CHROMA_PERSIST_DIR=./data/chroma
TOP_K=5
HISTORY_MAX_TURNS=4

# Hybrid retrieval (BM25 + vector, fused with Reciprocal Rank Fusion)
HYBRID_POOL=20
RRF_K=60

# LLM rerank of retrieved candidates (free models keep this at $0)
RERANK_ENABLED=true
RERANK_MAX_TOKENS=160
