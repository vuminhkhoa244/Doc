# Copy to .env and fill in real values before running the service.
# Get an OpenRouter key at https://openrouter.ai/keys

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: only needed when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here

CHAT_MODEL=dots-studio/dots-3-note-preview:free
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Ask OpenRouter to skip hidden reasoning tokens (some providers ignore this)
CHAT_REASONING_ENABLED=false

# Postgres DSN with the pgvector extension available (e.g. Neon).
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
# Schema this service owns inside DATABASE_URL. Keeps the vector table out of
# Hibernate's way when the database is shared with the backend.
DB_SCHEMA=ai_service
# Must match the dimension of EMBEDDING_MODEL (Nemotron embed = 1024).
VECTOR_DIM=1024

TOP_K=5
HISTORY_MAX_TURNS=4

# Hybrid retrieval (BM25 + vector, fused with Reciprocal Rank Fusion)
HYBRID_POOL=20
RRF_K=60

# LLM rerank of retrieved candidates (free models keep this at $0)
RERANK_ENABLED=true
RERANK_MAX_TOKENS=1000
