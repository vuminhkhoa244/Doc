# Copy to .env and fill in real values before running `docker compose up`.

# OpenRouter key — used for both chat and embeddings (OpenAI-compatible API).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Provider selection: openrouter (default) or openai
LLM_PROVIDER=openrouter

# Optional: only needed when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key

# Models (OpenRouter uses provider/model slugs; ":free" suffix = free tier)
CHAT_MODEL=dots-studio/dots-3-note-preview:free
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# Ask OpenRouter to skip hidden reasoning tokens so answers start immediately.
# Some providers ignore this; set true to re-enable thinking.
CHAT_REASONING_ENABLED=false

# Web search (SearXNG in docker-compose). Defaults work out of the box;
# override only if you run your own SearXNG instance.
# WEB_SEARCH_BASE_URL=http://searxng:8080
# WEB_SEARCH_TIMEOUT_SECONDS=8
# WEB_SEARCH_MAX_RESULTS=5

# OCR for scanned PDFs (Tesseract is preinstalled in the backend image)
# APP_OCR_ENABLED=true
# APP_OCR_LANGUAGE=vie+eng
# APP_OCR_MAX_PAGES=50

# PostgreSQL password used by the backend
POSTGRES_PASSWORD=assistant

# Secret used to sign JWTs — use a long random string in any shared environment
APP_JWT_SECRET=change-this-development-secret-change-this-development-secret
