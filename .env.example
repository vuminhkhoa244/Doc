# Copy to .env and fill in real values before running `docker compose up`.

# OpenRouter key — used for both chat and embeddings (OpenAI-compatible API).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Provider selection: openrouter (default) or openai
LLM_PROVIDER=openrouter

# Optional: only needed when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key

# Models (OpenRouter uses provider/model slugs; ":free" suffix = free tier)
CHAT_MODEL=dots-studio/dots-3-note-preview:free
EMBEDDING_MODEL=openai/text-embedding-3-small

# PostgreSQL password used by the backend
POSTGRES_PASSWORD=assistant

# Secret used to sign JWTs — use a long random string in any shared environment
APP_JWT_SECRET=change-this-development-secret-change-this-development-secret
